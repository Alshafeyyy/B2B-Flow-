# Apollo API Credentials
APOLLO_API_KEY=your_apollo_api_key_here

# LLM Gateway (llmgateway.io) — routes every AI call, one key for all providers/models
LLM_GATEWAY_API_KEY=your_llm_gateway_api_key_here
LLM_GATEWAY_BASE_URL=https://api.llmgateway.io/v1

# Model used for qualification + all deep research (needs real-time web search)
SEARCH_MODEL=sonar

# Model used only for contact selection (pure reasoning, no search needed — cheap)
REASONING_MODEL=gpt-oss-20b

# Target Offering Context (Customize to your product/service)
OFFERING_DESCRIPTION=ALX Africa B2B corporate training offer (Data Science, Data Analytics, Data Engineering, Cybersecurity, Graphic Design, Content Creation bootcamps for corporate teams)
