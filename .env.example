# Apollo API Credentials
APOLLO_API_KEY=your_apollo_api_key_here

# Perplexity API Credentials
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Perplexity Model (options: sonar, sonar-pro, sonar-reasoning)
PERPLEXITY_MODEL=sonar

# Target Offering Context (Customize to your product/service)
OFFERING_DESCRIPTION=ALX Africa B2B corporate training offer (Data Science, Data Analytics, Data Engineering, Cybersecurity, Graphic Design, Content Creation bootcamps for corporate teams)
